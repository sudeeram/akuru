[Unit]
Description=AKURU FastAPI
After=network.target postgresql.service redis-server.service
Requires=postgresql.service redis-server.service

[Service]
User=akuru
Group=akuru
WorkingDirectory=/opt/akuru/source-code/backend
EnvironmentFile=/etc/akuru/akuru.env
ExecStart=/opt/akuru/source-code/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/akuru
UMask=0027

[Install]
WantedBy=multi-user.target
