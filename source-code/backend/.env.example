# AKURU backend configuration template
# Copy this file to .env and replace every environment-specific value.
# Never commit the resulting .env file.

# --- Application runtime ---
# Use development locally, test in CI, and production on the public server.
AKURU_ENVIRONMENT=development

# --- PostgreSQL ---
# Connection used by FastAPI, Alembic migrations, tests, and maintenance commands.
AKURU_DATABASE_HOST=127.0.0.1
AKURU_DATABASE_PORT=5432
AKURU_DATABASE_NAME=akuru
AKURU_DATABASE_USER=postgres
AKURU_DATABASE_PASSWORD=change-me

# --- Browser and HTTP security ---
# JSON arrays must retain their brackets and quotes.
# Add only the frontend origins and HTTP hostnames that should reach this backend.
AKURU_CORS_ORIGINS='["http://localhost:5180","http://127.0.0.1:5180","http://localhost:5181","http://127.0.0.1:5181"]'
AKURU_ALLOWED_HOSTS='["localhost","127.0.0.1"]'
# Use false for local HTTP. Production HTTPS must use true.
AKURU_COOKIE_SECURE=false

# --- Authentication and login throttling ---
# Session lifetime in hours. Accepted range: 1–168.
AKURU_SESSION_HOURS=12
# Lock a client/username pair after this many failures during the window.
AKURU_LOGIN_ATTEMPT_LIMIT=8
AKURU_LOGIN_WINDOW_MINUTES=15
AKURU_LOGIN_LOCK_MINUTES=15
# Distributed API rate limits. Production uses Redis and fails closed if it is unavailable.
AKURU_API_RATE_LIMIT_PER_MINUTE=120
AKURU_AUTH_RATE_LIMIT_PER_MINUTE=60
# Required in production. Generate at least 32 random bytes; used for operations authentication and pseudonyms.
AKURU_OPERATIONS_TOKEN=

# --- Family quotas and privacy retention ---
# Per-family rolling 24-hour assessment budgets.
AKURU_FAMILY_AI_REQUESTS_PER_DAY=100
AKURU_FAMILY_AI_TOKENS_PER_DAY=500000
# Total retained handwritten-working storage for all children in one family.
AKURU_FAMILY_WORKING_STORAGE_BYTES=104857600
# Answers/results are redacted after this period; working files and unapproved media are deleted sooner.
AKURU_ASSESSMENT_ANSWER_RETENTION_DAYS=730
AKURU_WORKING_FILE_RETENTION_DAYS=90
AKURU_REJECTED_MEDIA_RETENTION_DAYS=30
AKURU_AUDIT_RETENTION_DAYS=2190

# --- Private document storage ---
# local uses an absolute filesystem path outside the source checkout.
# oci uses the optional OCI settings below instead.
AKURU_STORAGE_BACKEND=local
AKURU_LOCAL_STORAGE_PATH=/data/akuru/documents
# Maximum original upload size in bytes; 52,428,800 bytes equals 50 MB.
AKURU_MAX_DOCUMENT_BYTES=52428800
# Production must configure a malware scanner such as clamscan; blank disables it for local development.
AKURU_MALWARE_SCAN_COMMAND=
AKURU_MALWARE_SCAN_TIMEOUT_SECONDS=30

# --- Asynchronous document processing ---
# Redis transports job IDs; PostgreSQL remains the authoritative job store.
AKURU_REDIS_URL=redis://127.0.0.1:6379/0
AKURU_DOCUMENT_QUEUE_NAME=akuru:documents
# Per-job limits enforced by the document worker.
AKURU_DOCUMENT_JOB_TIMEOUT_SECONDS=120
AKURU_DOCUMENT_JOB_MEMORY_MB=512
AKURU_DOCUMENT_MAX_PAGES=500
AKURU_EXTRACTION_VERSION=deterministic-v1
# Review images are rendered at this DPI. Sparse pages below the character threshold use OCR.
AKURU_DOCUMENT_RENDER_DPI=180
AKURU_DOCUMENT_OCR_MIN_CHARACTERS=40
# Absolute path may be used when Tesseract is not on the worker's PATH.
AKURU_TESSERACT_COMMAND=tesseract

# --- AI provider (backend only) ---
# Keep disabled until an OpenAI project key and model are explicitly configured.
# Never use a browser/frontend environment variable for this key.
AKURU_AI_PROVIDER=disabled
AKURU_OPENAI_API_KEY=
AKURU_OPENAI_MODEL=
# Conceptual illustrations use this model and size, regardless of the text model on each routed account.
AKURU_OPENAI_IMAGE_MODEL=gpt-image-1
AKURU_OPENAI_IMAGE_SIZE=1024x1024
# JSON map of Admin-visible credential aliases to secret keys. Keep this line backend-only.
# Example: AKURU_OPENAI_ACCOUNT_KEYS='{"HOME":"sk-...","BACKUP":"sk-..."}'
AKURU_OPENAI_ACCOUNT_KEYS={}
# Per-request reliability and spend controls. The SDK does not retry beyond this AKURU limit.
AKURU_AI_TIMEOUT_SECONDS=45
AKURU_AI_MAX_RETRIES=2
AKURU_AI_MAX_CONCURRENCY=2
AKURU_AI_MAX_PAGES_PER_REQUEST=8
AKURU_AI_MAX_INPUT_CHARACTERS=80000
AKURU_AI_MAX_IMAGE_BYTES=20971520
AKURU_AI_MAX_OUTPUT_TOKENS=4000

# --- Tutor Agent release controls ---
# These default to false. Enable each capability only after its Tutor roadmap release gate passes.
# Formal assessments override these settings and always block Tutor assistance server-side.
AKURU_TUTOR_TEXT_ENABLED=false
AKURU_TUTOR_VOICE_ENABLED=false
AKURU_TUTOR_TOOLS_ENABLED=false
# Minimum cosine similarity required before AKURU may cite a textbook passage (0 to 1).
AKURU_TUTOR_RETRIEVAL_MIN_SCORE=0.45

# Step 12 publishes automatic marks at or above this confidence; lower results await review.
AKURU_ASSESSMENT_CONFIDENCE_THRESHOLD=0.75
# Maximum approved textbook chunks snapshotted for each answer assessment.
AKURU_ASSESSMENT_CONTEXT_CHUNKS=12
# Student working limit and OCR confidence below which the original must be reviewed.
AKURU_ASSESSMENT_WORKING_MAX_BYTES=5242880
AKURU_ASSESSMENT_OCR_REVIEW_THRESHOLD=0.85

# --- Retrieval embeddings ---
# local gives deterministic, offline retrieval for development. Use openai in production for semantic quality.
AKURU_EMBEDDING_PROVIDER=local
# With OpenAI, use text-embedding-3-small; its output is reduced to the schema's 256 dimensions.
AKURU_EMBEDDING_MODEL=akuru-local-v1
AKURU_EMBEDDING_DIMENSIONS=256

# --- Optional OCI Object Storage ---
# Uncomment these only when AKURU_STORAGE_BACKEND=oci.
# AKURU_OCI_OBJECT_NAMESPACE=your-namespace
# AKURU_OCI_OBJECT_BUCKET=akuru-private-documents
